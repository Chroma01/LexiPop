{
  "devDependencies": {
    "@eslint/compat": "^2.1.0",
    "@eslint/css": "^1.4.0",
    "@eslint/js": "^10.0.1",
    "@floating-ui/core": "1.8.0",
    "@floating-ui/dom": "1.8.0",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.11.0",
    "prettier": "3.9.6",
    "web-ext": "^10.6.0"
  },
  "scripts": {
    "dev": "web-ext --config=web-ext.config.mjs run",
    "build": "web-ext --config=web-ext.config.mjs build --overwrite-dest",
    "lint": "eslint . --fix",
    "lint:check": "eslint .",
    "lint:ext": "web-ext --config=web-ext.config.mjs lint",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "prepare": "npm run lint && npm run format && npm run lint:ext"
  }
}
